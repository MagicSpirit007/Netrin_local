# Netrin 可选 Supabase 同步配置（模板）
#
# 用法：把本文件复制为同目录下的 .env.local，填入真实值。
#   - .env.local 已被 git 忽略，不会进仓库；
#   - .env.local 已被 git 忽略，不会进入版本库；
#   - 未配置时，应用仍以完整的本地优先模式运行；
#   - 仅使用项目的公开 anon/publishable key，绝不要放入 service_role key。

VITE_SUPABASE_URL=https://your-project.example.com
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# 部署在站点根目录时留空或设为 /；旧版 /netrin/ 部署可设为 /netrin/。
NETRIN_BASE_PATH=/

# Phase 6 route-service experiment only. These are read by
# scripts/route-service-experiment.mjs, not by the PWA runtime.
# Leave blank unless you are running a local/self-hosted routing service.
NETRIN_VALHALLA_URL=
NETRIN_GRAPHHOPPER_URL=
NETRIN_GRAPHHOPPER_KEY=
NETRIN_OSRM_URL=
