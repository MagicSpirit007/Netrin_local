{
  "cellId": "netrin-cell",
  "plugins": [
    {
      "id": "trail-rating-receptor",
      "role": "receptor",
      "sourceLevel": "cell",
      "capabilities": ["route.save", "route.rate", "stop.like"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    },
    {
      "id": "nearby-trail-synapse",
      "role": "synapse",
      "sourceLevel": "cell",
      "capabilities": ["route.rank.nearby", "route.rank.theme", "route.rank.season"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    },
    {
      "id": "field-guide-phenotype",
      "role": "phenotype",
      "sourceLevel": "cell",
      "capabilities": ["theme.tokens", "theme.mobile-layout", "theme.pixel-map"],
      "platforms": { "web": "content-only", "ios": "content-only", "android": "content-only" }
    },
    {
      "id": "geo-location-dendrite",
      "role": "dendrite",
      "sourceLevel": "cell",
      "capabilities": ["location.watch", "location.record", "location.snap-toggle"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    },
    {
      "id": "media-upload-dendrite",
      "role": "dendrite",
      "sourceLevel": "cell",
      "capabilities": ["media.pick", "media.compress", "field-note.attach-photo"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    },
    {
      "id": "route-share-axon",
      "role": "axon",
      "sourceLevel": "cell",
      "capabilities": ["route.export", "route.share-link"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    },
    {
      "id": "route-import-dendrite",
      "role": "dendrite",
      "sourceLevel": "cell",
      "capabilities": ["route.import-json", "route.import-link"],
      "platforms": { "web": "supported", "ios": "prebundled", "android": "prebundled" }
    }
  ]
}
