{
  "name": "netrin-cell",
  "private": true,
  "version": "0.1.0",
  "description": "A local-first, offline-capable campus nature route PWA.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MagicSpirit007/Netrin_local.git"
  },
  "bugs": {
    "url": "https://github.com/MagicSpirit007/Netrin_local/issues"
  },
  "homepage": "https://github.com/MagicSpirit007/Netrin_local#readme",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.18.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "extract:paths": "node scripts/extract-campus-paths.mjs",
    "extract:water": "node scripts/extract-basemap-water.mjs",
    "experiment:route-service": "node scripts/route-service-experiment.mjs --route-title=test1",
    "preview": "vite preview",
    "smoke": "node scripts/smoke-build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@supabase/supabase-js": "2.112.3",
    "@turf/distance": "7.4.0",
    "@turf/helpers": "7.4.0",
    "@turf/nearest-point-on-line": "7.4.0",
    "i18next": "^23.15.2",
    "localforage": "^1.10.0",
    "lxgw-wenkai-screen-webfont": "1.7.0",
    "maplibre-gl": "^4.7.1",
    "pmtiles": "4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.1.1",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/plugin-transform-runtime": "8.0.1",
    "@babel/runtime": "8.0.0",
    "@biomejs/biome": "2.5.11",
    "@mapbox/vector-tile": "^3.0.0",
    "@types/node": "26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "6.1.1",
    "pbf": "^5.1.2",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11"
  }
}
